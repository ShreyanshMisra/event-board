<div id="event-detail">
  <section
    class="max-w-3xl mx-auto p-6 rounded-2xl bg-white border transition-all duration-300
      <%= event.status === 'published'
        ? 'border-green-300 shadow-lg shadow-green-100'
        : event.status === 'cancelled'
        ? 'border-red-300 shadow-lg shadow-red-100'
        : 'border-slate-200 shadow-lg'
      %>"
  >
    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-slate-500 mb-2">Event Detail</p>
        <h1 class="text-3xl font-bold text-slate-900"><%= event.title %></h1>
        <p class="mt-2 text-slate-500">
          Organized by <strong class="text-slate-700"><%= event.organizerId %></strong>
        </p>
      </div>

      <span
        x-data="{ changed: true }"
        x-init="setTimeout(() => changed = false, 700)"
        :class="changed ? 'scale-110 ring-2 ring-offset-2' : 'scale-100'"
        class="inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold transition-all duration-300
          <%= event.status === 'draft'
            ? 'bg-slate-100 text-slate-700 ring-slate-300'
            : event.status === 'published'
            ? 'bg-green-100 text-green-700 ring-green-300'
            : event.status === 'cancelled'
            ? 'bg-red-100 text-red-700 ring-red-300'
            : 'bg-yellow-100 text-yellow-700 ring-yellow-300'
          %>"
      >
        <%= event.status %>
      </span>
    </div>

    <% if (pageError) { %>
      <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-4 text-red-700">
        <%= pageError %>
      </div>
    <% } %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-slate-800">
      <div class="md:col-span-2 rounded-xl bg-slate-50 p-4">
        <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Description</h2>
        <p class="mt-2 leading-relaxed"><%= event.description %></p>
      </div>

      <div class="rounded-xl border border-slate-200 p-4">
        <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Location</h2>
        <p class="mt-2"><%= event.location %></p>
      </div>

      <div class="rounded-xl border border-slate-200 p-4">
        <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Category</h2>
        <p class="mt-2 capitalize"><%= event.category %></p>
      </div>

      <div
        class="rounded-xl border border-slate-200 p-4"
        x-data="{
          label: '',
          init() {
            const start = new Date('<%= event.startDate %>');
            const now = new Date();
            const diffDays = Math.round((start - now) / (1000 * 60 * 60 * 24));

            if (diffDays === 0) this.label = 'today';
            else if (diffDays === 1) this.label = 'tomorrow';
            else if (diffDays > 1) this.label = `in ${diffDays} days`;
            else this.label = `${Math.abs(diffDays)} days ago`;
          }
        }"
      >
        <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Start</h2>
        <p class="mt-2">
          <%= new Date(event.startDate).toLocaleString(undefined, {
            dateStyle: "medium",
            timeStyle: "short"
          }) %>
        </p>
        <p class="mt-1 text-sm text-slate-500" x-text="label"></p>
      </div>

      <div
        class="rounded-xl border border-slate-200 p-4"
        x-data="{
          label: '',
          init() {
            const end = new Date('<%= event.endDate %>');
            const now = new Date();
            const diffDays = Math.round((end - now) / (1000 * 60 * 60 * 24));

            if (diffDays === 0) this.label = 'today';
            else if (diffDays === 1) this.label = 'tomorrow';
            else if (diffDays > 1) this.label = `in ${diffDays} days`;
            else this.label = `${Math.abs(diffDays)} days ago`;
          }
        }"
      >
        <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide">End</h2>
        <p class="mt-2">
          <%= new Date(event.endDate).toLocaleString(undefined, {
            dateStyle: "medium",
            timeStyle: "short"
          }) %>
        </p>
        <p class="mt-1 text-sm text-slate-500" x-text="label"></p>
      </div>

      <div class="rounded-xl border border-slate-200 p-4">
        <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Capacity</h2>
        <p class="mt-2"><%= event.capacity %></p>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-slate-200">
      <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-3">
        Actions
      </h2>

      <div class="flex flex-wrap gap-3">
        <% if (canEdit) { %>
          <a
            href="/events/<%= event.id %>/edit"
            class="inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
          >
            Edit Event
          </a>
        <% } %>

        <% if (canPublish) { %>
          <button
            type="button"
            hx-post="/events/<%= event.id %>/publish"
            hx-target="#event-detail"
            hx-swap="outerHTML"
            class="inline-flex items-center rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-500"
          >
            Publish Event
          </button>
        <% } %>

        <% if (canCancel) { %>
          <button
            type="button"
            hx-post="/events/<%= event.id %>/cancel"
            hx-target="#event-detail"
            hx-swap="outerHTML"
            class="inline-flex items-center rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50"
          >
            Cancel Event
          </button>
        <% } %>

        <% if (canSave) { %>
          <%- include("../saved/partials/save-button", { eventId: event.id, isSaved }) %>
        <% } %>
      </div>

      <% if (canRsvp) { %>
        <div class="mt-4">
          <div
            id="rsvp-section"
            hx-get="/events/<%= event.id %>/rsvp-section"
            hx-trigger="load"
            hx-swap="outerHTML"
          >
            <div class="text-sm text-slate-500">Loading RSVP...</div>
          </div>
        </div>
      <% } %>
    </div>
  </section>
</div>