<section class="max-w-3xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7 text-yellow-500">
      <path fill-rule="evenodd" d="M6.32 2.577a49.255 49.255 0 0 1 11.36 0c1.497.174 2.57 1.46 2.57 2.93V21a.75.75 0 0 1-1.085.67L12 18.089l-7.165 3.583A.75.75 0 0 1 3.75 21V5.507c0-1.47 1.073-2.756 2.57-2.93Z" clip-rule="evenodd" />
    </svg>
    <h1 class="text-2xl font-bold text-slate-900">Saved Events</h1>
  </div>

  <% if (pageError) { %>
    <%- include("../partials/error", { message: pageError }) %>
  <% } %>

  <% if (savedEvents.length === 0) { %>
    <div class="p-10 border border-slate-200 rounded-2xl bg-white shadow-sm text-center">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-slate-300 mx-auto mb-3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z" />
      </svg>
      <p class="text-slate-500 font-medium">You haven't saved any events yet.</p>
      <p class="text-sm text-slate-400 mt-1">Browse events and click <span class="font-medium">Save for Later</span> to build your collection.</p>
    </div>
  <% } else { %>
    <div class="space-y-3">
      <% for (const item of savedEvents) { %>
        <div class="p-5 border border-slate-200 rounded-2xl bg-white shadow-sm hover:shadow-md hover:border-slate-300 transition-all">
          <div class="flex items-start justify-between gap-3 flex-wrap">
            <div class="min-w-0">
              <a href="/events/<%= item.event.id %>" class="text-base font-semibold text-slate-900 hover:text-blue-600 transition-colors">
                <%= item.event.title %>
              </a>
              <p class="text-sm text-slate-500 mt-0.5 flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-3.5 h-3.5 shrink-0">
                  <path fill-rule="evenodd" d="m7.539 14.841.003.003.002.002a.755.755 0 0 0 .912 0l.002-.002.003-.003.012-.009a5.57 5.57 0 0 0 .19-.153 15.588 15.588 0 0 0 2.046-2.082c1.101-1.362 2.291-3.342 2.291-5.597A5 5 0 0 0 3 7c0 2.255 1.19 4.235 2.292 5.597a15.591 15.591 0 0 0 2.047 2.082 8.916 8.916 0 0 0 .19.153l.012.01ZM8 8.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" clip-rule="evenodd" />
                </svg>
                <%= item.event.location %>
              </p>
            </div>
            <% const categoryColors = {
              academic: 'bg-blue-50 text-blue-700',
              social: 'bg-purple-50 text-purple-700',
              sports: 'bg-green-50 text-green-700',
              club: 'bg-orange-50 text-orange-700',
              career: 'bg-cyan-50 text-cyan-700',
              arts: 'bg-pink-50 text-pink-700',
              volunteer: 'bg-teal-50 text-teal-700',
              other: 'bg-slate-100 text-slate-600'
            }; %>
            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-medium capitalize <%= categoryColors[item.event.category] || 'bg-slate-100 text-slate-600' %>">
              <%= item.event.category %>
            </span>
          </div>

          <div class="flex items-center gap-3 mt-3 text-xs text-slate-500 flex-wrap">
            <span class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-3.5 h-3.5">
                <path d="M5.75 7.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM5 10.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0ZM10.25 7.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM9.5 10.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0ZM8 7.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM7.25 10.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0Z" />
                <path fill-rule="evenodd" d="M4.75 1a.75.75 0 0 1 .75.75V3h5V1.75a.75.75 0 0 1 1.5 0V3h.75A2.75 2.75 0 0 1 15.5 5.75v7.5A2.75 2.75 0 0 1 12.75 16H3.25A2.75 2.75 0 0 1 .5 13.25v-7.5A2.75 2.75 0 0 1 3.25 3H4V1.75A.75.75 0 0 1 4.75 1Zm-1.5 5.5c0-.414.336-.75.75-.75h9a.75.75 0 0 1 0 1.5h-9a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
              </svg>
              <%= new Date(item.event.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
              &ndash;
              <%= new Date(item.event.endDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %>
            </span>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</section>
