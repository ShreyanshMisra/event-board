<div
  id="rsvp-section"
  x-data
  x-transition.opacity.duration.300ms
  class="flex items-center gap-3 flex-wrap"
>
  <form
    hx-post="/events/<%= eventId %>/rsvp"
    hx-target="#rsvp-section"
    hx-swap="outerHTML settle:200ms"
  >
    <button
      type="submit"
      class="inline-flex items-center rounded-xl px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all duration-200 ease-in-out hover:-translate-y-0.5 hover:shadow-md
        <%= rsvpStatus === 'going'
          ? 'bg-red-600 hover:bg-red-500'
          : rsvpStatus === 'waitlisted'
          ? 'bg-yellow-600 hover:bg-yellow-500'
          : 'bg-blue-600 hover:bg-blue-500' %>"
    >
      <%= rsvpStatus === 'going'
        ? 'Cancel RSVP'
        : rsvpStatus === 'waitlisted'
        ? 'Leave Waitlist'
        : 'RSVP' %>
    </button>
  </form>

  <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700 transition-all duration-200">
    Attendees: <%= attendeeCount %>
  </span>

  <% if (rsvpStatus === "waitlisted") { %>
    <span class="inline-block rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold text-yellow-700 transition-all duration-200">
      Waitlisted
    </span>
  <% } else if (rsvpStatus === "going") { %>
    <span class="inline-block rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700 transition-all duration-200">
      Going
    </span>
  <% } else { %>
    <span class="inline-block rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 transition-all duration-200">
      Not going
    </span>
  <% } %>
</div>